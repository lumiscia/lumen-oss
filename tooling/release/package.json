{
  "name": "@lumiscia/release-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "publish-crates": "pnpm run build && node dist/publish-crates.js",
    "verify-crates": "pnpm run build && node dist/verify-crates.js",
    "sync-cargo-version": "pnpm run build && node dist/sync-cargo-version.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
