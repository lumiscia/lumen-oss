{
  "timeline": {
    "fps": 30,
    "duration_frames": 120
  },
  "render_settings": {
    "width": 1280,
    "height": 720,
    "background_color": [11, 16, 32, 255]
  },
  "metadata": {
    "title": "Expression Animation",
    "description": "Animates colours, vec2 positions and sizes with tween, easings, springs and s/ms units."
  },
  "nodes": [
    {
      "id": 1,
      "type": "background",
      "params": {
        "paint": "=tween(#0b1020, #2a1145, 0, 3s, 'in_out_cubic')",
        "width": 1280,
        "height": 720
      }
    },
    {
      "id": 2,
      "type": "shape",
      "params": {
        "geometry_kind": "rectangle",
        "width": 360,
        "height": 200,
        "border_radius": 28,
        "position": "=vec2(460, 720) + tween(vec2(0, 0), vec2(0, -460), 0, 18, 'out_expo') + tween(vec2(0, 0), vec2(-900, 0), 90, 14, 'in_back')",
        "fill_enabled": true,
        "fill_paint": "=tween(#22d3ee, #f472b6, 20, 40, 'in_out_cubic')",
        "stroke_enabled": false
      }
    },
    {
      "id": 3,
      "type": "shape",
      "params": {
        "geometry_kind": "ellipse",
        "width": "=1 + round(180 * spring((frame - 24) / fps, 170, 12))",
        "height": "=1 + round(180 * spring((frame - 24) / fps, 170, 12))",
        "position": "=vec2(1000, 360) - vec2(1, 1) * 90 * spring((frame - 24) / fps, 170, 12)",
        "fill_enabled": true,
        "fill_paint": "=tween(rgba(250, 204, 21, 0), rgba(250, 204, 21, 255), 24, 300ms)",
        "stroke_enabled": false
      }
    },
    {
      "id": 4,
      "type": "text",
      "params": {
        "content": "Expression animation",
        "font_family": "Roboto",
        "font_size": 48,
        "font_weight": 700,
        "position": "=vec2(120, 80) + tween(vec2(0, -40), vec2(0, 0), 6, 0.6s, 'out_back')",
        "color": "=tween(#ffffff00, #ffffff, 6, 0.6s)"
      }
    },
    {
      "id": 5,
      "type": "raster_multimerge",
      "params": {
        "opacity": 1.0
      }
    },
    {
      "id": 6,
      "type": "media_output"
    }
  ],
  "connections": [
    { "from_node": 1, "from_port": "output", "to_node": 5, "to_port": "layers" },
    { "from_node": 2, "from_port": "output", "to_node": 5, "to_port": "layers" },
    { "from_node": 3, "from_port": "output", "to_node": 5, "to_port": "layers" },
    { "from_node": 4, "from_port": "output", "to_node": 5, "to_port": "layers" },
    { "from_node": 5, "from_port": "output", "to_node": 6, "to_port": "source" }
  ]
}
