FROM debian:trixie-slim AS builder
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        clang \
        cmake \
        pkg-config \
        libvulkan-dev \
        libavcodec-dev \
        libavdevice-dev \
        libavfilter-dev \
        libavformat-dev \
        libavutil-dev \
        libswresample-dev \
        libswscale-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain 1.90.0
ENV PATH=/root/.cargo/bin:${PATH}
COPY . ./lumen
WORKDIR /workspace/lumen
RUN cargo build --release --bin lumen-runpod --features vulkan,cuda

FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libegl1 \
        libvulkan1 \
        vulkan-tools \
        ffmpeg \
        libavcodec61 \
        libavdevice61 \
        libavfilter10 \
        libavformat61 \
        libavutil59 \
        libswresample5 \
        libswscale8 \
    && rm -rf /var/lib/apt/lists/*
RUN rm -f /etc/vulkan/icd.d/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json \
    && mkdir -p /tmp/lumen-runtime \
    && chmod 700 /tmp/lumen-runtime
WORKDIR /app
COPY --from=builder /workspace/lumen/target/release/lumen-runpod /usr/local/bin/lumen-runpod
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV NVIDIA_VISIBLE_DEVICES=all
ENV LUMEN_HARDWARE_DECODE=1
ENV XDG_RUNTIME_DIR=/tmp/lumen-runtime
CMD ["/usr/local/bin/lumen-runpod"]
