{
  "canvas": {
    "width": 1280,
    "height": 720,
    "background": [8, 10, 18, 255]
  },
  "timeline": {
    "fps": { "num": 30, "den": 1 },
    "total_frames": 180
  },
  "layers": [
    {
      "id": "animated_bg",
      "z_index": 0,
      "opacity": {
        "keyframes": [
          { "frame": 0, "value": 0.35 },
          { "frame": 60, "value": 0.85, "easing": "ease_in_out" },
          { "frame": 179, "value": 0.55, "easing": "ease_out" }
        ]
      },
      "items": [
        {
          "id": "bg_rect",
          "start_frame": 0,
          "duration_frames": 180,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 1280,
            "height": 720
          },
          "content": {
            "type": "shape",
            "shape": "rectangle",
            "fill": [20, 26, 44, 255],
            "radius": 0
          }
        },
        {
          "id": "pulse_orb",
          "start_frame": 0,
          "duration_frames": 180,
          "opacity": {
            "keyframes": [
              { "frame": 0, "value": 0.2 },
              { "frame": 90, "value": 0.95, "easing": "ease_in" },
              { "frame": 179, "value": 0.3, "easing": "ease_out" }
            ]
          },
          "transform": {
            "x": "lerp(160, 280, 0.5)",
            "y": "max(90, 40 + 70)",
            "width": {
              "keyframes": [
                { "frame": 0, "value": 280 },
                { "frame": 90, "value": 500, "easing": "ease_in_out" },
                { "frame": 179, "value": 320, "easing": "ease_out" }
              ]
            },
            "height": {
              "keyframes": [
                { "frame": 0, "value": 280 },
                { "frame": 90, "value": 500, "easing": "ease_in_out" },
                { "frame": 179, "value": 320, "easing": "ease_out" }
              ]
            },
            "rotation_degrees": {
              "keyframes": [
                { "frame": 0, "value": -8 },
                { "frame": 90, "value": 14, "easing": "ease_in_out" },
                { "frame": 179, "value": -4, "easing": "ease_out" }
              ]
            }
          },
          "content": {
            "type": "shape",
            "shape": "ellipse",
            "fill": [86, 132, 255, 220]
          }
        }
      ]
    },
    {
      "id": "title_layer",
      "z_index": 2,
      "opacity": "clamp(0.9, 0.0, 1.0)",
      "items": [
        {
          "id": "title_line",
          "start_frame": 0,
          "duration_frames": 180,
          "transform": {
            "x": "lerp(120, 160, 0.4)",
            "y": "80 + 24",
            "width": 980,
            "height": 140
          },
          "content": {
            "type": "text",
            "text": "Expressions + Keyframes",
            "font_size": {
              "keyframes": [
                { "frame": 0, "value": 58 },
                { "frame": 80, "value": 72, "easing": "ease_in" },
                { "frame": 179, "value": 64, "easing": "ease_out" }
              ]
            },
            "font_weight": { "expr": "max(580, 640)" },
            "align": "left",
            "line_height": "clamp(1.12, 1.0, 1.4)",
            "color": [248, 250, 255, 255]
          }
        },
        {
          "id": "subtitle_line",
          "start_frame": 20,
          "duration_frames": 160,
          "opacity": {
            "keyframes": [
              { "frame": 20, "value": 0.0 },
              { "frame": 48, "value": 0.85, "easing": "ease_out" },
              { "frame": 179, "value": 0.85 }
            ]
          },
          "transform": {
            "x": 128,
            "y": 206,
            "width": 980,
            "height": 90
          },
          "content": {
            "type": "text",
            "text": "scene json delegate in lumen-local",
            "font_size": "lerp(28, 32, 0.5)",
            "font_weight": 520,
            "align": "left",
            "line_height": 1.2,
            "color": [194, 210, 255, 255]
          }
        }
      ]
    }
  ],
  "audio": { "tracks": [] }
}
