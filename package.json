{
  "name": "lumen",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source rendering core behind Lumiscia.",
  "keywords": [
    "composition",
    "gpu",
    "lumen",
    "lumiscia",
    "media",
    "rendering"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git"
  },
  "type": "module",
  "scripts": {
    "ready": "just ready",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "publish:packages": "changeset publish",
    "sync:cargo-version": "pnpm --filter @lumiscia/release-tools sync-cargo-version",
    "release:version": "pnpm version:packages && pnpm sync:cargo-version && pnpm install --lockfile-only && cargo update --workspace",
    "release:build": "just wasm-bindings-release && pnpm -r --filter './packages/*' build",
    "release:dry-run": "just wasm-bindings-release && pnpm -r --filter './packages/*' build && cargo publish --workspace --dry-run --allow-dirty",
    "check": "pnpm format:check && pnpm lint && pnpm -r check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:integration": "LUMEN_SDK_INTEGRATION=1 vitest run packages/lumen-sdk/test/integration.test.ts",
    "build": "pnpm -r --filter '!lumen' build"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/react": "catalog:",
    "binaryen": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
