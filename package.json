{
  "name": "lumen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "just ready",
    "check": "pnpm format:check && pnpm lint && pnpm -r check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "build": "pnpm -r --filter '!lumen' --filter '!lumen-bindings' build && pnpm --filter lumen-bindings check"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "binaryen": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
