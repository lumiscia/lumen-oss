{
  "name": "@lumiscia/example-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "pnpm --filter @lumiscia/lumen-shared build && pnpm --filter @lumiscia/lumen-sdk build && pnpm build && node dist/index.js"
  },
  "dependencies": {
    "@lumiscia/lumen-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
