{
  "name": "@lumiscia/example-vite-svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .svelte-kit *.tsbuildinfo",
    "dev": "pnpm --filter @lumiscia/lumen-shared build && vite"
  },
  "dependencies": {
    "@lumiscia/lumen-bindings": "workspace:*",
    "@lumiscia/lumen-shared": "workspace:*",
    "@lumiscia/lumen-svelte": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "vite": "catalog:",
    "vite-plugin-top-level-await": "catalog:",
    "vite-plugin-wasm": "catalog:"
  }
}
