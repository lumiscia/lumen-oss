{
  "name": "@lumiscia/example-vite-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "pnpm --filter @lumiscia/lumen-shared build && pnpm --filter @lumiscia/lumen-react build && vite"
  },
  "dependencies": {
    "@lumiscia/lumen-bindings": "workspace:*",
    "@lumiscia/lumen-preview": "workspace:*",
    "@lumiscia/lumen-react": "workspace:*",
    "@lumiscia/lumen-shared": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "catalog:",
    "vite-plugin-top-level-await": "catalog:",
    "vite-plugin-wasm": "catalog:"
  }
}
