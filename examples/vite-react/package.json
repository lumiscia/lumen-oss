{
  "name": "@lumiscia/example-vite-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "predev": "test -f ../../packages/lumen-bindings/wasm/lumen_wasm.js || { echo 'Generate the wasm bindings first: just wasm-bindings-debug (see examples/README.md)' >&2; exit 1; } && pnpm --filter '@lumiscia/example-vite-react^...' build",
    "dev": "vite"
  },
  "dependencies": {
    "@lumiscia/lumen-preview": "workspace:*",
    "@lumiscia/lumen-react": "workspace:*",
    "@lumiscia/lumen-shared": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "catalog:"
  }
}
