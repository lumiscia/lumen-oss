  },
  "dependencies": {
    "@lumiscia/lumen-bindings": "workspace:*",
    "@lumiscia/lumen-preview": "workspace:*",
    "@lumiscia/lumen-react": "workspace:*",
    "@lumiscia/lumen-shared": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
