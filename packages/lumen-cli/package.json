{
  "name": "@lumiscia/lumen-cli",
  "version": "0.6.0-beta.2",
  "description": "The lumen command, and a Node, Bun and Deno API to check, render and preview Lumen compositions on a local GPU.",
  "keywords": [
    "cli",
    "composition",
    "gpu",
    "lumen",
    "lumiscia",
    "rendering",
    "video"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss/tree/main/crates/cli#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git",
    "directory": "packages/lumen-cli"
  },
  "bin": {
    "lumen": "bin/lumen.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "test -f dist/index.js"
  },
  "dependencies": {
    "@lumiscia/lumen-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "optionalDependencies": {
    "@lumiscia/lumen-cli-darwin-arm64": "workspace:*",
    "@lumiscia/lumen-cli-linux-arm64": "workspace:*",
    "@lumiscia/lumen-cli-linux-x64": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
