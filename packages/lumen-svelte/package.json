{
  "name": "@lumiscia/lumen-svelte",
  "version": "0.2.2",
  "description": "Svelte preview components and state helpers for Lumen compositions.",
  "keywords": [
    "lumen",
    "lumiscia",
    "media",
    "preview",
    "rendering",
    "svelte"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git",
    "directory": "packages/lumen-svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumiscia/lumen-preview": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": ">=5"
  }
}
