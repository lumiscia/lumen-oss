{
  "name": "@lumiscia/lumen-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for creating media and render jobs with Lumen.",
  "keywords": [
    "composition",
    "lumen",
    "lumiscia",
    "media",
    "rendering",
    "sdk"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git",
    "directory": "packages/lumen-sdk"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:integration": "LUMEN_SDK_INTEGRATION=1 vitest run test/integration.test.ts"
  },
  "dependencies": {
    "@lumiscia/lumen-shared": "workspace:*",
    "@lumiscia/lumen-types": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
