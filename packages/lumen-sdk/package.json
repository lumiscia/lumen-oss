{
  "name": "@lumiscia/lumen-sdk",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.ts",
      "default": "./dist/cloudflare.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lumiscia/lumen-shared": "workspace:*",
    "@lumiscia/lumen-types": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
