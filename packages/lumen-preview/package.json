{
  "name": "lumen-preview",
  "version": "0.0.0",
  "files": [
    "src/**/*.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./audio-engine": {
      "types": "./src/audio-engine.ts",
      "default": "./src/audio-engine.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "default": "./src/media/index.ts"
    },
    "./preview": {
      "types": "./src/preview.ts",
      "default": "./src/preview.ts"
    }
  },
  "dependencies": {
    "mediabunny": "^1.40.1"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
