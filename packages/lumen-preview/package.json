{
  "name": "@lumiscia/lumen-preview",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./audio-engine": {
      "types": "./src/audio-engine.ts",
      "default": "./dist/audio-engine.js"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "default": "./dist/media/index.js"
    },
    "./preview": {
      "types": "./src/preview.ts",
      "default": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "mediabunny": "^1.40.1"
  }
}
