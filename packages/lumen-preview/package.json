{
  "name": "@lumiscia/lumen-preview",
  "version": "0.6.0-beta.1",
  "description": "Browser preview runtime and media bridge for Lumen compositions.",
  "keywords": [
    "gpu",
    "lumen",
    "lumiscia",
    "media",
    "preview",
    "rendering"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git",
    "directory": "packages/lumen-preview"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "default": "./dist/advanced.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./worker-host": {
      "types": "./dist/worker-host.d.ts",
      "default": "./dist/worker-host.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumiscia/lumen-types": "workspace:*",
    "mediabunny": "^1.62.1"
  }
}
