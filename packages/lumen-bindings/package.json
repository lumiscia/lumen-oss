{
  "name": "@lumiscia/lumen-bindings",
  "version": "0.2.1",
  "description": "Generated WebAssembly bindings for Lumen browser and Node preview runtimes.",
  "keywords": [
    "gpu",
    "lumen",
    "lumiscia",
    "rendering",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git",
    "directory": "packages/lumen-bindings"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/bundler/index.js",
    "./src/bundler/preview-worker.js",
    "./src/bundler/lumen_wasm.js",
    "./src/browser/index.js",
    "./src/browser/lumen_wasm.js",
    "./src/node/index.js",
    "./src/node/lumen_wasm.js",
    "./src/no-modules/lumen_wasm.js"
  ],
  "main": "./src/bundler/index.js",
  "types": "./src/bundler/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/bundler/index.d.ts",
      "default": "./src/bundler/index.js"
    },
    "./bundler": {
      "types": "./src/bundler/index.d.ts",
      "default": "./src/bundler/index.js"
    },
    "./browser": {
      "types": "./src/browser/index.d.ts",
      "default": "./src/browser/index.js"
    },
    "./web": {
      "types": "./src/browser/index.d.ts",
      "default": "./src/browser/index.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    },
    "./nodejs": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    },
    "./no-modules": {
      "default": "./src/no-modules/lumen_wasm.js"
    }
  },
  "scripts": {
    "build": "just wasm-bindings-release",
    "check": "test ! -f src/bundler/lumen_wasm.d.ts || tsc -p tsconfig.json --noEmit",
    "clean": "find src -type f -name 'lumen_wasm*' -delete && rm -rf src/.cache *.tsbuildinfo"
  },
  "dependencies": {
    "@lumiscia/lumen-preview": "workspace:*"
  }
}
