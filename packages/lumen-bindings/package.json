{
  "name": "@lumiscia/lumen-bindings",
  "version": "0.4.0",
  "description": "WebAssembly bindings for the Lumen browser preview, with a Node adapter.",
  "keywords": [
    "gpu",
    "lumen",
    "lumiscia",
    "rendering",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/lumiscia/lumen-oss#readme",
  "bugs": {
    "url": "https://github.com/lumiscia/lumen-oss/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumiscia/lumen-oss.git",
    "directory": "packages/lumen-bindings"
  },
  "files": [
    "dist",
    "urls.d.ts",
    "urls.js",
    "wasm"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/browser/worker.js",
    "./dist/node/index.js"
  ],
  "main": "./dist/browser/index.js",
  "types": "./dist/browser/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/worker.js": "./dist/browser/worker.js",
    "./bundler": {
      "types": "./dist/bundler/index.d.ts",
      "default": "./dist/bundler/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./urls": {
      "types": "./urls.d.ts",
      "default": "./urls.js"
    }
  },
  "scripts": {
    "build": "test -f wasm/lumen_wasm.d.ts || { echo 'packages/lumen-bindings: wasm/ is missing. Generate it with: just wasm-bindings-debug' >&2; exit 1; } && (tsc -p tsconfig.json && esbuild dist/browser/worker.js --bundle --minify --format=esm --platform=browser --allow-overwrite --outfile=dist/browser/worker.js)",
    "check": "test -f wasm/lumen_wasm.d.ts || { echo 'packages/lumen-bindings: wasm/ is missing. Generate it with: just wasm-bindings-debug' >&2; exit 1; } && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist wasm wasm.tmp-* *.tsbuildinfo",
    "test:node": "node test/node-load.mjs && node test/init-overlap.mjs"
  },
  "dependencies": {
    "@lumiscia/lumen-preview": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:"
  }
}
